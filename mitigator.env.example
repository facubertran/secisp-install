SEC_MIT_ENABLED=true
SEC_MIT_TLS_INSECURE=true
SEC_MIT_DRY_RUN=false
SEC_MIT_VERIFY_RULES=false
SEC_MIT_PW=TO4leZ03PglUxMukAK1H
SEC_MIT_LOCAL_IPS=10.215.6.13
# Estaba escrita TRES veces (200, 2000, 2000). systemd procesa el
# EnvironmentFile linea por linea y la ultima asignacion pisa a las
# anteriores, asi que el valor efectivo siempre fue 2000: se deja una sola,
# explicita, sin cambiar el comportamiento.
SEC_MIT_MAX_CUSTOMERS_BLOCKED_PER_HOUR=2000
SEC_MIT_TICK_SECONDS=30

# ─── Licenciamiento (ola 12) ────────────────────────────────────────────────
# NINGUNA de las dos es obligatoria: los defaults de abajo son exactamente los
# que usa el binario, y un host SIN licencia arranca igual y SIGUE MITIGANDO
# (solo quedan apagadas las features opcionales: detect.anomaly, enrich.geo,
# notify, dashboards, multi_router, upgrade). Se dejan escritas para que, si
# hace falta moverlas, el nombre se copie y no se tipee.
#
# OJO: la validacion de entorno es ESTRICTA. Un typo en el nombre de una
# variable SEC_* no se ignora -- aborta el arranque de los cuatro roles con
# "variable de entorno desconocida". Descomentar con cuidado.
#
# Si se cambia alguna, hay que cambiarla en LOS CUATRO .env (cada rol tiene su
# propio EnvironmentFile) y ademas en /etc/secisp/doctor.env, porque
# `secisp doctor` lee SEC_LICENSE_PATH por su cuenta y con otra ruta estaria
# chequeando un archivo distinto al que usan los daemons.
#
#SEC_LICENSE_PATH=/etc/secisp/license.lic
#SEC_LICENSE_STATE_PATH=/var/lib/secisp/state/license.watermark
